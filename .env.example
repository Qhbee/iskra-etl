# 复制为 .env（勿提交密钥）。本项目 .gitignore 已忽略 .env

# ---------- 语料与切块（LlamaIndex）----------
# 语料根目录（默认同仓库兄弟目录 ../iskra-data）；按本机路径取消下一行注释
# ISKRA_CORPUS_ROOT=/path/to/iskra-data

# 切段产物 JSON Lines（可调）
# ISKRA_CHUNK_JSONL=out/chunks.jsonl

# MarkdownNodeParser：标题路径元数据中的分隔符（默认 /）
# ISKRA_HEADER_PATH_SEP=/

# SentenceSplitter：token 上限与重叠（LlamaIndex 默认含义）
ISKRA_SENTENCE_CHUNK_SIZE=1024
ISKRA_SENTENCE_CHUNK_OVERLAP=128

# 长段切分：代码里 SentenceSplitter 使用 "\n\n"（常见 Markdown：段间一个空行）。LlamaIndex 默认是 "\n\n\n"。
# Windows 的 CRLF 在切段前会规范成 \n，否则按 "\n\n" 切段落会匹配不到。
# 需要三换行分段时：split_corpus_to_chunks(..., paragraph_separator="\n\n\n")。

# 碎片缝合：Unicode 字符 len() 低于此则与后续片段合并，直至更大；文末仍不足则并入上一块
ISKRA_CONSOLIDATE_MIN_CHARS=512

# ---------- Sentence-Transformers ----------
# cuda / cpu；不设则自动：有 CUDA 版 PyTorch+GPU 用 cuda，否则 cpu
ISKRA_EMBED_DEVICE=cuda

# 与 iskra-engine/sql/001_init.sql 中 vector(N) 一致（当前为 1024）；embed 脚本 --validate-dim 用其校验
ISKRA_EMBED_DIM=1024

# 批大小（目标窗口；CUDA OOM 时会自动降级，见 embedder.encode_texts）
ISKRA_EMBED_BATCH_SIZE=48

# 可选，默认已为 Jina small retrieval
# ISKRA_EMBED_MODEL=jinaai/jina-embeddings-v5-text-small-retrieval

# ---------- HuggingFace 缓存 ----------
# 模型权重默认缓存在 HF_HOME/hub/models--用户名--仓库名；
# Windows 常为 %USERPROFILE%\.cache\huggingface\hub\
# 想换磁盘时取消下一行注释并改成你的路径
# HF_HOME=D:\hf-cache

# HuggingFace Token（提速/提额）；勿把真实 Token 提交到 Git
# HF_TOKEN=
