# 复制为 .env（勿提交密钥）。本项目 .gitignore 已忽略 .env

# ---------- 语料与切块（LlamaIndex）----------
# 语料根目录（默认同仓库兄弟目录 ../iskra-data）；按本机路径取消下一行注释
# ISKRA_CORPUS_ROOT=/path/to/iskra-data

# 切段产物 JSON Lines（可调）
# ISKRA_CHUNK_JSONL=out/chunks.jsonl

# embed_chunks 输出的行对齐向量（与 JSONL 行顺序一致，供 export_parquet 组装）
# ISKRA_CHUNK_EMBEDDINGS_NPY=out/chunks_embeddings.npy

# tokenize_chunks 输出的行对齐分词文本（与 JSONL 行顺序一致，供 export_parquet / loader）
# ISKRA_CHUNK_TOKENIZED_TXT=out/chunks_tokenized.txt

# tokenize_chunks 输出的行对齐分词文本（供 backfill_chunk_text_search_vector.py）
# ISKRA_CHUNK_TOKENIZED_TSV=out/chunks_tokenized.tsv

# MarkdownNodeParser：标题路径元数据中的分隔符（默认 /）
# ISKRA_HEADER_PATH_SEP=/

# SentenceSplitter：token 上限与重叠（LlamaIndex 默认含义）
ISKRA_SENTENCE_CHUNK_SIZE=1024
ISKRA_SENTENCE_CHUNK_OVERLAP=128

# 长段切分：代码里 SentenceSplitter 使用 "\n\n"（常见 Markdown：段间一个空行）。LlamaIndex 默认是 "\n\n\n"。
# Windows 的 CRLF 在切段前会规范成 \n，否则按 "\n\n" 切段落会匹配不到。
# 需要三换行分段时：split_corpus_to_chunks(..., paragraph_separator="\n\n\n")。

# 碎片缝合：Unicode 字符 len() 低于此则与后续片段合并，直至更大；文末仍不足则并入上一块
ISKRA_CONSOLIDATE_MIN_CHARS=512

# ---------- Sentence-Transformers ----------
# cuda / cpu；不设则自动：有 CUDA 版 PyTorch+GPU 用 cuda，否则 cpu
ISKRA_EMBED_DEVICE=cuda

# 与 iskra-engine/sql/001_init.sql 中 vector(N) 一致（当前为 1024）；embed 脚本 --validate-dim 用其校验
ISKRA_EMBED_DIM=1024

# 批大小（目标窗口；CUDA OOM 时会自动降级，见 embedder.encode_texts）
ISKRA_EMBED_BATCH_SIZE=48

# Jina retrieval：仅送入 model.encode 前拼接；JSONL chunk_text 不变。不设则默认 "Document: "；设空可关
ISKRA_EMBED_DOCUMENT_PREFIX="Document: "

# 可选，默认已为 Jina small retrieval
# ISKRA_EMBED_MODEL=jinaai/jina-embeddings-v5-text-small-retrieval

# ---------- Parquet 导出（显式 document_id，与语料 glob 排序一致）----------
# 首篇 document.id（默认 1）；全量重导前请与库内现有数据协调，避免主键冲突
# ISKRA_DOCUMENT_ID_START=1

# ISKRA_DOCUMENTS_PARQUET=out/documents.parquet
# ISKRA_CHUNKS_PARQUET=out/chunks.parquet

# ---------- 远程 PostgreSQL 加载（笔记本：SSH 隧道 + psycopg COPY）----------
# 跳板 SSH（可用密钥；密码次之，勿提交 .env）
# ISKRA_SSH_JUMP_HOST=your.vps.example
# ISKRA_SSH_JUMP_PORT=22
# ISKRA_SSH_USER=ubuntu
# ISKRA_SSH_KEY_PATH 和 PASSWORD 有一个就行
# ISKRA_SSH_KEY_PATH=%USERPROFILE%\.ssh\id_rsa
# ISKRA_SSH_PASSWORD=
# 隧道保活秒数（paramiko；默认 30）
# ISKRA_SSH_KEEPALIVE=30

# 从跳板机上「看」PostgreSQL 的地址（Docker 桥接常用 127.0.0.1；内网则填内网 IP）
# ISKRA_PG_REMOTE_HOST=127.0.0.1
# ISKRA_PG_REMOTE_PORT=5432
# 本地绑定端口；0 表示由 sshtunnel 自动分配
# ISKRA_PG_LOCAL_BIND_PORT=0

# ISKRA_PG_USER=postgres
# ISKRA_PG_PASSWORD=
# ISKRA_PG_DB=iskra
#
# ISKRA_PG_SSLMODE — 传给 psycopg 的 libpq sslmode（客户端 ↔ PostgreSQL 是否走 TLS；与 SSH 隧道无关，各管各的）
#   disable — 不用 SSL（仅内网/测试慎用）
#   allow — 先非 SSL、必要时再试 SSL（少见）
#   prefer — 优先 SSL；服务端未开 SSL 时可退回非加密（默认常用、省心）
#   require — 必须 SSL；不校验证书是否由可信 CA 签发（仍有加密，不防「假服务器」）
#   verify-ca / verify-full — 校验证书链或主机名（云数据库常要求）
# 经 SSH 隧道连本机映射端口时，隧道本身已加密；PG 是否再开 SSL 取决于服务端是否强制。
# ISKRA_PG_SSLMODE=prefer
#
# 目标库已有数据时全量重导须明确允许（或命令行 --truncate）
# ISKRA_LOAD_TRUNCATE — 是否允许「目标库非空时」先整表清空再全量 COPY（危险，默认关）
#   未设置 / 0 / false / no（及任意其它值）→ 视为不允许：若 document 或 chunk 里已有行，load 会报错退出，防止误覆盖。
#   1 / true / yes → 允许：执行 TRUNCATE document RESTART IDENTITY CASCADE（级联清空 chunk），再写入新 Parquet。
# 空库首次导入不必设为 1；库已空时不会执行 TRUNCATE。
# 命令行 ``load_to_db.py --truncate`` 为 true 时优先生效（不再读本变量）。
# ISKRA_LOAD_TRUNCATE=false

# ---------- HuggingFace 缓存 ----------
# 模型权重默认缓存在 HF_HOME/hub/models--用户名--仓库名；
# Windows 常为 %USERPROFILE%\.cache\huggingface\hub\
# 想换磁盘时取消下一行注释并改成你的路径
# HF_HOME=D:\hf-cache

# HuggingFace Token（提速/提额）；勿把真实 Token 提交到 Git
# HF_TOKEN=
